# Required for lead submission (server-only; never prefix with NEXT_PUBLIC_)
CRM_API_URL=https://erp.infinityrealty.ae/api/crm/external/leads
CRM_API_KEY=replace-with-CRM_EXTERNAL_API_KEY-from-the-ERP

# Public site (optional; defaults to https://dxb.invest.infinityrealty.ae)
NEXT_PUBLIC_SITE_URL=

# Optional — each section renders only when set
NEXT_PUBLIC_COMPANY_PHONE=
NEXT_PUBLIC_COMPANY_EMAIL=
NEXT_PUBLIC_COMPANY_ADDRESS=
NEXT_PUBLIC_WHATSAPP_NUMBER=       # digits with country code, e.g. 9715xxxxxxxx
NEXT_PUBLIC_BOOKING_URL=
NEXT_PUBLIC_PRIVACY_URL=
NEXT_PUBLIC_PRIVACY_VERSION=
NEXT_PUBLIC_TERMS_URL=
NEXT_PUBLIC_REGULATORY_TEXT=       # verified licence/permit line shown in footer
NEXT_PUBLIC_GTM_ID=
